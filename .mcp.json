{
    "servers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "playwright": {
            "command": "cmd",
            "args": [
                "/c", "npx", "-y", "@microsoft/mcp-server-playwright"
            ]
        },
        "memory": {
            "command": "cmd",
            "args": [
                "/c", "npx", "-y", "@modelcontextprotocol/server-memory"
            ]
        },
        "sequential-thinking": {
            "command": "cmd",
            "args": [
                "/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"
            ]
        },
        "serena": {
            "command": "cmd",
            "args": [
                "/c", "npx", "-y", "@oraios/serena"
            ]
        }
    }
}
