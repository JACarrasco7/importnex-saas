{
    "servers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@microsoft/mcp-server-playwright"
            ]
        }
    }
}